eated monitoring.","feed":{"published_epoch":1794466467.5012727,"interval_seconds":60,"next_update_epoch":1794466527.5012727},"model_note":"Gen 7.1 standard (71s-32) is Gen 7 standard with policy net v4.1 in place of v4; nothing else differs. Gen 7 standard (7s-32) is Gen 6 fast (6-32: same bidder, lead net, hand-fit scorer, layouts and 32 samples) with the gen7 engine (bridge_harness/gen7.py) and policy net v4: layouts weighted by the play so far from trick 7, exact ties broken by the net, and at tricks 3 to 6 a tree search over the net's likeliest cards that re-values the cards the search rates within 0.25 tricks of its best (trust 0.3, stake rule at 0.5 IMPs, at most 3 tricks, 8 layouts). Settings are in the bot's `gen7` block. Every other bot is unchanged from the source run. docs/gen7_alpha_2026-11-11.md has the details.","source_cohort_overlap":false,"allocation":{"71s-32~6-32":1,"71s-32~7s-32":2},"statistics_policy":{},"collection":{"updated_epoch":1794466462.534933,"running":true,"workers":4,"total_completed":43,"training_only_completed":0},"difference_views":{"0":{"groups":{"71s-32~6-32":{"bidding":{"n":15,"total":0,"mean":0.0,"variance":0.0,"sd":0.0,"se":0.0,"ci":[0.0,0.0],"wins":0,"ties":15,"losses":0},"play":{"n":15,"total":41,"mean":2.7333333333333334,"variance":15.78095238095238,"sd":3.972524686009186,"se":1.0257014634207615,"ci":[0.533422488810674,4.933244177855993],"wins":6,"ties":7,"losses":2},"total":{"n":15,"total":41,"mean":2.7333333333333334,"variance":15.78095238095238,"sd":3.972524686009186,"se":1.0257014634207615,"ci":[0.533422488810674,4.933244177855993],"wins":6,"ties":7,"losses":2},"different_bidding":0},"71s-32~7s-32":{"bidding":{"n":28,"total":0,"mean":0.0,"variance":0.0,"sd":0.0,"se":0.0,"ci":[0.0,0.0],"wins":0,"ties":28,"losses":0},"play":{"n":28,"total":-12,"mean":-0.42857142857142855,"variance":5.142857142857142,"sd":2.2677868380553634,"se":0.42857142857142855,"ci":[-1.3079273642058362,0.45078450706297907],"wins":2,"ties":22,"losses"