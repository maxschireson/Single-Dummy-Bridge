[Unit]
Description=Sid play server (people against the bridge bot)
After=network-online.target
Wants=network-online.target

[Service]
User=sidplay
Group=sidplay
EnvironmentFile=/etc/sidplay.env
WorkingDirectory=/opt/sidplay/app/play
ExecStart=/opt/sidplay/venv/bin/uvicorn sidplay.app:app --app-dir /opt/sidplay/app/play --host 127.0.0.1 --port 8090 --no-access-log
Restart=on-failure
RestartSec=5
# Bot workers run ahead of the arena collectors (Nice 0) while someone is playing and use nothing when idle.
Nice=-10
MemoryMax=8G
TasksMax=512
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sidplay
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Environment=HOME=/var/lib/sidplay
Environment=TF_CPP_MIN_LOG_LEVEL=2

[Install]
WantedBy=multi-user.target
