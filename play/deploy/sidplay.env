# /etc/sidplay.env: settings for the Sid play server (see play/README.md for every variable).
SIDPLAY_BUNDLE=/opt/sidplay/bundle
SIDPLAY_DATA=/var/lib/sidplay
# Interactive bot processes (calls, cards, claim checks) and background ones (Sid's own table on each deal).
SIDPLAY_WORKERS=2
SIDPLAY_BACKGROUND_WORKERS=1
# Added to the service's Nice -10 for the background workers: 10 puts Sid's own tables level with the collectors.
SIDPLAY_BACKGROUND_NICE=10
SIDPLAY_MAX_TABLES=12
SIDPLAY_IDLE_MINUTES=30
SIDPLAY_SID_TABLES=1
# Analyse each finished board (yours and Sid's table): one light process, no models, at the background niceness.
SIDPLAY_ANALYSIS=1
SIDPLAY_ANALYSIS_WORKERS=1
SIDPLAY_PACE=0.5
SIDPLAY_TRICK_PAUSE=1.2
# Set to 1 once the site is served over HTTPS (caddy.sh does this).
SIDPLAY_SECURE_COOKIES=0
